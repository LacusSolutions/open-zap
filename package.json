{
  "name": "openzap",
  "version": "0.1.0",
  "private": true,
  "description": "OpenZap - Free WhatsApp click-to-chat link and QR code generator.",
  "scripts": {
    "prepare": "husky",
    "commit": "commit",
    "release": "semantic-release",
    "dev": "next dev --port 30303",
    "development": "npm run dev",
    "build": "next build",
    "prod": "next start",
    "production": "npm run prod",
    "lint": "eslint src/ commitlint.config.mjs eslint.config.mjs next.config.ts postcss.config.mjs vitest.config.mts",
    "lint:fix": "bun run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "libphonenumber-js": "^1.12.42",
    "lucide-react": "^1.12.0",
    "next": "16.2.4",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "react-hook-form": "^7.74.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/prompt-cli": "^20.5.2",
    "@next/eslint-plugin-next": "^16.2.4",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20.19.39",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-any": "^2.5.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ]
}

# Canonical site URL used by metadata, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://openzap.app

# Formspree project id that backs the feedback dialog.
# Create a form at https://formspree.io/ and paste the id (after /f/) here.
# If left empty, the feedback form logs to the console instead.
NEXT_PUBLIC_FORMSPREE_ID=
